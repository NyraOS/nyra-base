diff --git a/ntp-proto/src/bootstrap.rs b/ntp-proto/src/bootstrap.rs
new file mode 100644
index 0000000..26a02a5
--- /dev/null
+++ b/ntp-proto/src/bootstrap.rs
@@ -0,0 +1,351 @@
+// SPDX-License-Identifier: Unlicense
+//! Correcting a clock that is far off (Nyra OS: ntpd-rs-wrong-clock.patch, public domain).
+//!
+//! A key exchange checks the server's certificate like any TLS client, its dates included. A clock
+//! outside their validity (an empty RTC battery, a clock years ahead) would therefore never be
+//! corrected. Until the first clock update since boot:
+//! 1. a key exchange checks the server's certificate (chain, name and dates) not at the handshake,
+//!    but at the time the server then gives: that time counts only if the certificate was valid then.
+//!    The handshake still proves that the server holds the certificate's key;
+//! 2. no time counts below the floor: the image's date (the modification time of
+//!    /usr/lib/clock-epoch) or the last clock update, whichever is later;
+//! 3. the clock moves only when enough sources agree (`minimum-agreeing-sources` in the
+//!    configuration, with NTS servers of different operators), as without this patch.
+//!
+//! After the first clock update, key exchanges check the certificate at the handshake again.
+
+use std::{
+    fs,
+    sync::{
+        Arc, LazyLock,
+        atomic::{AtomicBool, Ordering},
+    },
+    time::{Duration, SystemTime, UNIX_EPOCH},
+};
+
+use rustls23::{
+    DigitallySignedStruct, Error, SignatureScheme,
+    client::danger::{HandshakeSignatureValid, ServerCertVerified, ServerCertVerifier},
+    pki_types::{CertificateDer, UnixTime},
+};
+use tracing::warn;
+
+use crate::tls_utils::{Certificate, PlatformVerifier, ServerName};
+
+/// Its modification time is the image's date (systemd's convention, see systemd(1)).
+const IMAGE_DATE_FILE: &str = "/usr/lib/clock-epoch";
+/// Written at every clock update: its modification time is the last good time, its content the
+/// boot ID of that update.
+const LAST_UPDATE_FILE: &str = "/var/lib/ntpd-rs/last-clock-update";
+const BOOT_ID_FILE: &str = "/proc/sys/kernel/random/boot_id";
+
+static CLOCK_UPDATED: LazyLock<AtomicBool> = LazyLock::new(|| {
+    let saved = fs::read_to_string(LAST_UPDATE_FILE).ok();
+    let boot_id = fs::read_to_string(BOOT_ID_FILE).ok();
+    AtomicBool::new(updated_this_boot(saved.as_deref(), boot_id.as_deref()))
+});
+
+fn updated_this_boot(saved: Option<&str>, boot_id: Option<&str>) -> bool {
+    saved.is_some() && saved == boot_id
+}
+
+/// Whether the clock was updated since boot, by this run of the daemon or an earlier one.
+pub(crate) fn clock_updated() -> bool {
+    CLOCK_UPDATED.load(Ordering::Relaxed)
+}
+
+/// After every clock update: ends the bootstrap and saves the time as the next floor.
+pub(crate) fn note_clock_update() {
+    CLOCK_UPDATED.store(true, Ordering::Relaxed);
+    let boot_id = fs::read_to_string(BOOT_ID_FILE).unwrap_or_default();
+    if let Err(e) = fs::write(LAST_UPDATE_FILE, boot_id) {
+        warn!("Could not save the time of the clock update in {LAST_UPDATE_FILE}: {e}");
+    }
+}
+
+/// The earliest time a source may give until the first clock update: the image's date or the last
+/// clock update. None afterwards, when the last update can be a few milliseconds ahead of a source
+/// that is just as good.
+pub(crate) fn floor() -> SystemTime {
+    if clock_updated() {
+        return UNIX_EPOCH;
+    }
+    latest_modification(&[IMAGE_DATE_FILE, LAST_UPDATE_FILE])
+}
+
+/// The latest modification time of these files; a missing file does not count.
+fn latest_modification(files: &[&str]) -> SystemTime {
+    files
+        .iter()
+        .filter_map(|file| fs::metadata(file).and_then(|m| m.modified()).ok())
+        .max()
+        .unwrap_or(UNIX_EPOCH)
+}
+
+/// The time a source gives: the local clock plus the measured offset.
+pub(crate) fn source_time(offset_seconds: f64) -> SystemTime {
+    let now = SystemTime::now();
+    let offset = Duration::try_from_secs_f64(offset_seconds.abs()).unwrap_or(Duration::MAX);
+    let time = if offset_seconds >= 0.0 {
+        now.checked_add(offset)
+    } else {
+        now.checked_sub(offset)
+    };
+    time.unwrap_or(UNIX_EPOCH)
+}
+
+/// Whether a source's time counts: never below the floor, and only at a time its certificate was
+/// valid when that was not checked at the handshake.
+pub(crate) fn check_time(
+    time: SystemTime,
+    floor: SystemTime,
+    certificate: Option<&CertificateCheck>,
+) -> Result<(), &'static str> {
+    if time < floor {
+        return Err("below the image's date or the last clock update");
+    }
+    if certificate.is_some_and(|c| !c.valid_at(time)) {
+        return Err("the server's certificate is not valid at that time");
+    }
+    Ok(())
+}
+
+/// A server certificate from a key exchange before the first clock update, checked at the times
+/// the server gives.
+pub(crate) struct CertificateCheck {
+    verifier: Arc<PlatformVerifier>,
+    server_name: ServerName<'static>,
+    chain: Vec<Certificate>,
+}
+
+impl CertificateCheck {
+    pub(crate) fn new(
+        verifier: Arc<PlatformVerifier>,
+        server_name: ServerName<'static>,
+        chain: &[Certificate],
+    ) -> Self {
+        CertificateCheck {
+            verifier,
+            server_name,
+            chain: chain.to_vec(),
+        }
+    }
+
+    /// The same check as at a handshake (chain, name, dates), with `time` as the current time.
+    pub(crate) fn valid_at(&self, time: SystemTime) -> bool {
+        let Some((end_entity, intermediates)) = self.chain.split_first() else {
+            return false;
+        };
+        let Ok(since_epoch) = time.duration_since(UNIX_EPOCH) else {
+            return false;
+        };
+        let now = UnixTime::since_unix_epoch(since_epoch);
+        self.verifier
+            .verify_server_cert(end_entity, intermediates, &self.server_name, &[], now)
+            .is_ok()
+    }
+}
+
+/// The verifier of a key exchange before the first clock update: the server must still prove that
+/// it holds the key of the certificate it presents, but the certificate itself is checked later,
+/// by `CertificateCheck`, at the time the server gives.
+#[derive(Debug)]
+pub(crate) struct DeferredVerifier(pub(crate) Arc<PlatformVerifier>);
+
+impl ServerCertVerifier for DeferredVerifier {
+    fn verify_server_cert(
+        &self,
+        _end_entity: &CertificateDer<'_>,
+        _intermediates: &[CertificateDer<'_>],
+        _server_name: &ServerName<'_>,
+        _ocsp_response: &[u8],
+        _now: UnixTime,
+    ) -> Result<ServerCertVerified, Error> {
+        Ok(ServerCertVerified::assertion())
+    }
+
+    fn verify_tls12_signature(
+        &self,
+        message: &[u8],
+        certificate: &CertificateDer<'_>,
+        signature: &DigitallySignedStruct,
+    ) -> Result<HandshakeSignatureValid, Error> {
+        self.0
+            .verify_tls12_signature(message, certificate, signature)
+    }
+
+    fn verify_tls13_signature(
+        &self,
+        message: &[u8],
+        certificate: &CertificateDer<'_>,
+        signature: &DigitallySignedStruct,
+    ) -> Result<HandshakeSignatureValid, Error> {
+        self.0
+            .verify_tls13_signature(message, certificate, signature)
+    }
+
+    fn supported_verify_schemes(&self) -> Vec<SignatureScheme> {
+        self.0.supported_verify_schemes()
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use crate::{
+        KeyExchangeClient, KeyExchangeResult, KeyExchangeServer, KeySet, NtpVersion,
+        NtsClientConfig, NtsError, NtsServerConfig, ProtocolVersion, tls_utils,
+    };
+
+    use super::*;
+
+    fn date(seconds_since_epoch: u64) -> SystemTime {
+        UNIX_EPOCH + Duration::from_secs(seconds_since_epoch)
+    }
+
+    // The test server's certificate (test-keys/end.pem, for localhost) is valid from 2026-02-27 to
+    // 2027-02-27.
+    const BEFORE_ITS_VALIDITY: u64 = 1_748_736_000; // 2025-06-01
+    const IN_ITS_VALIDITY: u64 = 1_780_272_000; // 2026-06-01
+    const AFTER_ITS_VALIDITY: u64 = 1_811_808_000; // 2027-06-01
+
+    /// A key exchange with the test server, by the name `server_name`.
+    async fn key_exchange(
+        server_name: &str,
+        check_later: bool,
+    ) -> Result<KeyExchangeResult, NtsError> {
+        let (client, server) = tokio::io::duplex(4096);
+        let client = async move {
+            let certificates = tls_utils::pemfile::certs(
+                &mut include_bytes!("../test-keys/testca.pem").as_slice(),
+            )
+            .collect::<Result<Arc<_>, _>>()
+            .unwrap();
+            let kex = KeyExchangeClient::new(&NtsClientConfig {
+                certificates,
+                protocol_version: ProtocolVersion::V4,
+            })
+            .unwrap();
+            kex.exchange_keys_checking_later(client, server_name.into(), [], check_later)
+                .await
+        };
+        let server = async move {
+            let certificate_chain = tls_utils::pemfile::certs(
+                &mut include_bytes!("../test-keys/end.fullchain.pem").as_slice(),
+            )
+            .collect::<Result<Vec<_>, _>>()
+            .unwrap();
+            let private_key = tls_utils::pemfile::private_key(
+                &mut include_bytes!("../test-keys/end.key").as_slice(),
+            )
+            .unwrap();
+            let kex = KeyExchangeServer::new(NtsServerConfig {
+                certificate_chain,
+                private_key,
+                accepted_versions: vec![NtpVersion::V4],
+                server: None,
+                port: None,
+                pool_authentication_tokens: vec![],
+            })
+            .unwrap();
+            let _ = kex
+                .handle_connection(server, &KeySet::new(), || None::<()>)
+                .await;
+        };
+        tokio::join!(client, server).0
+    }
+
+    #[tokio::test]
+    async fn certificate_checked_at_the_time_the_server_gives() {
+        let result = key_exchange("localhost", true).await.unwrap();
+        let certificate = result.nts.certificate.as_ref();
+        assert!(certificate.is_some());
+        let floor = UNIX_EPOCH;
+        assert!(check_time(date(IN_ITS_VALIDITY), floor, certificate).is_ok());
+        // Expired at the time the server gives: refused.
+        assert!(check_time(date(AFTER_ITS_VALIDITY), floor, certificate).is_err());
+        assert!(check_time(date(BEFORE_ITS_VALIDITY), floor, certificate).is_err());
+    }
+
+    #[tokio::test]
+    async fn certificate_for_another_name_refused_at_any_time() {
+        // The handshake goes through, the check at the server's time does not.
+        let result = key_exchange("example.com", true).await.unwrap();
+        let certificate = result.nts.certificate.as_ref();
+        assert!(check_time(date(IN_ITS_VALIDITY), UNIX_EPOCH, certificate).is_err());
+    }
+
+    #[tokio::test]
+    async fn strict_after_the_first_clock_update() {
+        // The certificate is checked at the handshake, as without the patch.
+        assert!(key_exchange("example.com", false).await.is_err());
+        let result = key_exchange("localhost", false).await.unwrap();
+        assert!(result.nts.certificate.is_none());
+        // Within one boot, a restarted daemon keeps the strict check.
+        let boot = Some("4f6c1d2e-0000-4000-8000-000000000001\n");
+        let other_boot = Some("4f6c1d2e-0000-4000-8000-000000000002\n");
+        assert!(updated_this_boot(boot, boot));
+        assert!(!updated_this_boot(other_boot, boot));
+        assert!(!updated_this_boot(None, boot));
+        assert!(!updated_this_boot(None, None));
+    }
+
+    #[test]
+    fn self_signed_certificate_refused_at_any_time() {
+        // For the right name and valid at that time, but from no trusted CA.
+        let certificate = |pem: &[u8]| {
+            let chain = tls_utils::pemfile::certs(&mut &pem[..])
+                .collect::<Result<Vec<_>, _>>()
+                .unwrap();
+            let roots = tls_utils::pemfile::certs(
+                &mut include_bytes!("../test-keys/testca.pem").as_slice(),
+            )
+            .collect::<Result<Vec<_>, _>>()
+            .unwrap();
+            let provider = tls_utils::client_config_builder().crypto_provider().clone();
+            let verifier = PlatformVerifier::new_with_extra_roots(roots)
+                .unwrap()
+                .with_provider(provider);
+            let name = ServerName::try_from("localhost").unwrap();
+            CertificateCheck::new(Arc::new(verifier), name, &chain)
+        };
+        let self_signed = certificate(include_bytes!("../test-keys/self-signed.pem"));
+        let from_the_test_ca = certificate(include_bytes!("../test-keys/end.fullchain.pem"));
+        assert!(!self_signed.valid_at(date(IN_ITS_VALIDITY)));
+        assert!(!self_signed.valid_at(date(AFTER_ITS_VALIDITY)));
+        assert!(from_the_test_ca.valid_at(date(IN_ITS_VALIDITY)));
+    }
+
+    #[test]
+    fn floor_is_the_latest_of_the_image_date_and_the_last_update() {
+        let dir = std::env::temp_dir().join(format!("ntp-proto-floor-{}", std::process::id()));
+        fs::create_dir_all(&dir).unwrap();
+        let image_date = dir.join("clock-epoch");
+        let last_update = dir.join("last-clock-update");
+        let missing = dir.join("missing");
+        fs::File::create(&image_date)
+            .unwrap()
+            .set_modified(date(BEFORE_ITS_VALIDITY))
+            .unwrap();
+        fs::File::create(&last_update)
+            .unwrap()
+            .set_modified(date(IN_ITS_VALIDITY))
+            .unwrap();
+        let path = |p: &std::path::Path| p.to_str().unwrap().to_owned();
+        let floor =
+            latest_modification(&[&path(&image_date), &path(&last_update), &path(&missing)]);
+        assert_eq!(floor, date(IN_ITS_VALIDITY));
+        assert_eq!(latest_modification(&[&path(&missing)]), UNIX_EPOCH);
+        // A time between the image's date and the last update is refused.
+        let between = date(BEFORE_ITS_VALIDITY) + Duration::from_secs(3600);
+        assert!(check_time(between, floor, None).is_err());
+        fs::remove_dir_all(&dir).unwrap();
+    }
+
+    #[test]
+    fn time_below_the_floor_refused() {
+        let floor = date(IN_ITS_VALIDITY);
+        assert!(check_time(floor - Duration::from_secs(1), floor, None).is_err());
+        assert!(check_time(floor, floor, None).is_ok());
+        assert!(check_time(floor + Duration::from_secs(3600), floor, None).is_ok());
+    }
+}
