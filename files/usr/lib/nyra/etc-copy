#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# Nyra OS: a copy of the system settings (/etc), for "Nyra OS Restore earlier settings" in the boot
# menu (docs/BOOT.md, "Restore earlier settings").
#   etc-copy daily    nyra-etc-copy.timer, once a day
#   etc-copy update   nyra-updated, before it stages an update
# Each copy is /var/lib/nyra/etc-copies/<date and time, UTC>-<daily|update>, made with cp -a (every
# file's owner, mode, ACLs and extended attributes as in /etc), inside a directory only root can
# enter (0700). It is made under a temporary name and renamed once complete, so an interrupted copy
# is never offered; the next run removes it. Copies older than 30 days are removed, except the three
# newest, so a machine that was off for a month still has the copies from before.
set -eu
umask 077
dir=/var/lib/nyra/etc-copies
case "${1:-}" in
daily | update) ;;
*) echo "usage: etc-copy daily|update" >&2; exit 2 ;;
esac
(umask 022 && mkdir -p /var/lib/nyra)
mkdir -p "$dir"
chmod 0700 "$dir"
# One run at a time (the daily copy and an update can meet): each removes the other's leftovers.
exec 9> "$dir/.lock"
flock 9
rm -rf "$dir"/.new-*
name="$(date -u +%Y-%m-%dT%H:%M:%SZ)-$1"
if ! cp -a --one-file-system /etc "$dir/.new-$name" || ! sync; then
	rm -rf "$dir/.new-$name"
	echo "etc-copy: could not copy /etc to $dir" >&2
	exit 1
fi
mv -T "$dir/.new-$name" "$dir/$name"
sync
echo "etc-copy: /etc copied to $dir/$name"
# Dates in the names compare as text. A copy dated in the future (a wrong clock) is kept.
old="$(date -u -d '30 days ago' +%Y-%m-%dT%H:%M:%SZ)"
find "$dir" -mindepth 1 -maxdepth 1 -printf '%f\n' |
	grep -E '^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z-(daily|update)$' | sort -r |
	tail -n +4 | mawk -v old="$old" 'substr($0, 1, 20) < old' | while read -r c; do
		rm -rf "${dir:?}/$c"
		echo "etc-copy: $c removed (older than 30 days)"
	done
