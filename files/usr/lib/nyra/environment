# Nyra: the system's environment (docs/DEFAULTS.md, "Terminal editor"), linked from /etc/environment,
# which pam_env reads for every PAM session (console and SSH logins, su, the desktop's login), so it
# updates with the image. EDITOR and VISUAL name the terminal editor for the programs that start
# one (git, crontab -e, systemctl edit, sudoedit); a user's own setting in a shell file wins.
EDITOR=editor
VISUAL=editor
