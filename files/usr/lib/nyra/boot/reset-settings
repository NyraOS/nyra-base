#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# Nyra OS: reset system settings (docs/BOOT.md), run by nyra-reset-settings.service when the "Nyra OS
# Reset settings" profile of the image's UKI boots. After a typed confirmation, the running system
# version's /etc (bootc keeps it in /sysroot/state/deploy/<digest>/etc and bind-mounts it on /etc)
# goes back to the /etc in the image, or, from the boot entry "Nyra OS Restore earlier settings"
# (the same profile; systemd-boot names the entry it started), to a copy of /etc that the user picks
# by its date (/usr/lib/nyra/etc-copy makes them). The accounts in a copy are not used: only its
# system accounts and groups (IDs outside 1000-59999), and only their names in its lists of group
# members. Kept, in both cases:
#   /etc/machine-id                    the machine's identity (journal, DHCP client ID)
#   /etc/hostname                      its name on the network
#   regular users (UID and primary     their lines in passwd, shadow, subuid and subgid, their own
#   GID 1000-59999)                    groups, and their membership in the image's groups (sudo:
#                                      administrators), so /home keeps its owners and they can log in;
#                                      a line is chosen by its name and its IDs together, a name found
#                                      twice in passwd, shadow, group or gshadow is not kept at all,
#                                      and a subordinate ID range only if it is the name's only one
#                                      and starts at 100000 or above
# /home and /var are not touched (the copies neither). Kept users' lines are copied as they are: this
# is not a cleanup of a compromised /etc. Power cuts: the new /etc is built next to the old one, then
# the two directories are exchanged in one step (renameat2 RENAME_EXCHANGE, mv --exchange), so a
# boot sees either the old /etc or the new one. The old one is kept as etc.nyra-old (mode 0700) next
# to it, until the next reset or restore replaces it or bootc removes this version.
set -eu
trap '' INT QUIT TSTP
# Files this script makes are for root only (the marker, the temporary copies of group and gshadow);
# the new /etc gets the image's modes, and the kept files below get theirs explicitly.
umask 077
# /usr/bin/awk is a Debian alternatives link through /etc/alternatives, which the broken (or empty)
# /etc this reset is for may not have: mawk itself, from /usr.
awk() { mawk "$@"; }

copies=/var/lib/nyra/etc-copies
# The boot entry systemd-boot started, in lower case (UTF-16 text after 4 bytes of attributes).
entry="$(tail -c +5 /sys/firmware/efi/efivars/LoaderEntrySelected-4a67b082-0a4c-41cf-b6c7-440b29bb8c4f 2>/dev/null | tr -d '\000' || true)"
d="$(sed -En 's/^(.* )?composefs=\??([0-9a-f]+)( .*)?$/\2/p' /proc/cmdline)"
state="/sysroot/state/deploy/$d"
if [ -z "$d" ] || [ ! -d "$state/etc" ]; then
	echo "reset-settings: this system's /etc was not found (${state}/etc)" >&2
	exec systemctl --job-mode=fail --no-block default
fi

src=""
if [ "$entry" = nyra-restore.conf ]; then
	# Newest first, numbered from 1.
	list="$(find "$copies" -mindepth 1 -maxdepth 1 -printf '%f\n' 2>/dev/null | grep -E '^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z-(daily|update)$' | sort -r || true)"
	if [ -z "$list" ]; then
		echo "Nyra OS: there is no copy of the system settings yet. Continuing the normal boot."
		exec systemctl --job-mode=fail --no-block default
	fi
	cat <<EOF

Nyra OS: restore earlier settings.
Everything in /etc goes back to a copy made on the date you choose. Kept: user accounts and their
passwords, the machine ID and the host name. Files in /home are not touched.
EOF
	n=0
	for c in $list; do
		n=$((n + 1))
		when="$(date -d "${c%Z-*}Z" '+%a %e %b %Y, %H:%M %Z' 2>/dev/null || echo "${c%-*}")"
		case "$c" in *-update) why="before an update" ;; *) why="daily copy" ;; esac
		printf '%4d  %s (%s)\n' "$n" "$when" "$why"
	done
	printf 'Type the number of the copy to restore, anything else or Control-D to boot normally: '
	answer=""
	read -r answer || true
	case "$answer" in
	"" | *[!0-9]*) ;;
	*) src="$(printf '%s\n' "$list" | sed -n "${answer}p" 2>/dev/null || true)" ;;
	esac
	if [ -z "$src" ]; then
		echo "Nothing changed. Continuing the normal boot."
		exec systemctl --job-mode=fail --no-block default
	fi
	echo "reset-settings: restoring the copy $src"
	src="$copies/$src"
else
	cat <<EOF

Nyra OS: reset system settings.
Everything in /etc goes back to this system version's defaults. Kept: user accounts and their
passwords, the machine ID and the host name. Files in /home are not touched.
EOF
	printf 'Type RESET to reset, anything else or Control-D to boot normally: '
	answer=""
	read -r answer || true
	if [ "$answer" != RESET ]; then
		echo "Nothing changed. Continuing the normal boot."
		exec systemctl --job-mode=fail --no-block default
	fi
fi

old="$state/etc" new="$state/etc.nyra-new" prev="$state/etc.nyra-old" image=/run/nyra-image-root
tmp="$state/etc.nyra-tmp"
mount -o remount,rw /sysroot
# Every /etc a reset builds carries the marker .nyra-reset-new until it is in place; it is made in
# etc.nyra-tmp and only renamed to etc.nyra-new with the marker inside, so an etc.nyra-new a reset
# built always has it. A leftover etc.nyra-tmp is an unfinished start: it goes. A leftover
# etc.nyra-new with the marker was built by a reset cut short before the switch: it goes. Without
# it, it is the previous /etc itself, from a reset cut short right after the switch: it is kept.
rm -f "$old/.nyra-reset-new"
rm -rf "$tmp"
if [ -d "$new" ]; then
	if [ -e "$new/.nyra-reset-new" ]; then
		rm -rf "$new"
	else
		rm -rf "$prev"
		mv "$new" "$prev"
		chmod 0700 "$prev"
		echo "reset-settings: the /etc before an interrupted reset is kept as $prev"
	fi
fi

echo "reset-settings: building the new /etc"
if [ -z "$src" ]; then
	# The image's /etc: under the bind mount of the state /etc, seen through a bind mount of / alone.
	mkdir -p "$image"
	mount --bind / "$image"
	mount -o remount,bind,ro "$image"
	src="$image/etc"
fi
mkdir -m 0700 "$tmp"
echo "reset-settings: preparing the new /etc"
: > "$tmp/.nyra-reset-new"
sync
mv -T "$tmp" "$new"
cp -a "$src/." "$new/"
chmod --reference="$src" "$new"
chown --reference="$src" "$new"
if [ "$src" = "$image/etc" ]; then umount "$image"; fi

uid_ok='$3 ~ /^[0-9]+$/ && $3 >= 1000 && $3 < 60000'
# A copy's accounts are not used (the image has none): its regular users and groups (ID 1000-59999)
# go, then its lines in shadow, subuid and subgid of anything that is not an account left in passwd,
# its gshadow lines of anything that is not a group left in group, and, in the lists of group members
# (group; administrators and members in gshadow), every name that is not an account left in passwd.
# The current accounts are added below, as for a reset.
# only FILE passwd|group|"" FIELDS: in $new/FILE, the lines whose first field is an account in
# $new/passwd or a group in $new/group (every line for ""), with only accounts of $new/passwd in the
# comma lists of FIELDS ("4", "3 4").
or_null() { if [ -f "$1" ]; then echo "$1"; else echo /dev/null; fi; }
only() {
	[ -f "$new/$1" ] || return 0
	keys=""
	[ "$2" != group ] || keys="$(or_null "$new/group")"
	# shellcheck disable=SC2086 # $keys: one path or none
	awk -F: -v OFS=: -v keyed="$2" -v fields="$3" '
		FILENAME == ARGV[1] { users[$1]; next }
		keyed == "group" && FILENAME == ARGV[2] { groups[$1]; next }
		keyed == "" || (keyed == "passwd" && ($1 in users)) || (keyed == "group" && ($1 in groups)) {
			n = split(fields, f, " ")
			for (i = 1; i <= n; i++) {
				if (NF < f[i]) continue
				m = split($f[i], names, ","); l = ""
				for (j = 1; j <= m; j++) if (names[j] in users) l = (l == "" ? names[j] : l "," names[j])
				$f[i] = l
			}
			print
		}' "$(or_null "$new/passwd")" $keys "$new/$1" > "$new/$1.nyra-tmp"
	cat "$new/$1.nyra-tmp" > "$new/$1"
	rm "$new/$1.nyra-tmp"
}
if [ "$src" != "$image/etc" ]; then
	for f in passwd group; do
		[ -f "$new/$f" ] || continue
		awk -F: "!($uid_ok)" "$new/$f" > "$new/$f.nyra-tmp"
		cat "$new/$f.nyra-tmp" > "$new/$f"
		rm "$new/$f.nyra-tmp"
	done
	only shadow passwd ""
	only subuid passwd ""
	only subgid passwd ""
	only group "" 4
	only gshadow group "3 4"
fi

# The line of NAME in FILE (exact match of the first field).
line() { awk -F: -v n="$2" '$1 == n { print; exit }' "$1" 2>/dev/null || true; }
has() { [ -n "$(line "$1" "$2")" ]; }
if grep -Eqx '[0-9a-f]{32}' "$old/machine-id" 2>/dev/null; then install -m 0444 "$old/machine-id" "$new/machine-id"; fi
if grep -Eqx '[A-Za-z0-9][A-Za-z0-9.-]{0,62}' "$old/hostname" 2>/dev/null; then install -m 0644 "$old/hostname" "$new/hostname"; fi
# Names that appear more than once in passwd, shadow, group or gshadow (each file on its own) are
# not kept: which of the lines would be the account?
dups=" $(for f in passwd shadow group gshadow; do
	if [ -f "$old/$f" ]; then awk -F: 'c[$1]++ == 1 { print $1 }' "$old/$f" || true; fi
done | tr '\n' ' ')"
# The lines of FILE with NF fields, a valid name that is not in $dups, and an ID (third field) of
# 1000-59999, and in passwd (7 fields) a primary group (fourth field) of 1000-59999 too; with NAME,
# only that name's line. A line is chosen by its name and its IDs together.
gid_ok='(nf != 7 || ($4 ~ /^[0-9]+$/ && $4 >= 1000 && $4 < 60000))'
kept() {
	awk -F: -v nf="$2" -v n="${3-}" -v dups="$dups" "NF == nf && \$1 ~ /^[a-z_][a-z0-9_.-]*\$/ &&
		!index(dups, \" \" \$1 \" \") && $uid_ok && $gid_ok && (n == \"\" || \$1 == n)" "$1" 2>/dev/null || true
}
users="$(kept "$old/passwd" 7 | awk -F: '{ print $1 }')"
for u in $users; do
	has "$new/passwd" "$u" && continue
	kept "$old/passwd" 7 "$u" >> "$new/passwd"
	sh="$(awk -F: -v u="$u" 'NF == 9 && $1 == u { print; exit }' "$old/shadow" 2>/dev/null || true)"
	echo "${sh:-$u:!:1::::::}" >> "$new/shadow"
	# The user's range of subordinate IDs (containers), if it is their only line in the file and
	# starts at 100000 or above (useradd's SUB_UID_MIN and SUB_GID_MIN): below that are the IDs of the
	# system and of the users themselves (and systemd's dynamic users, nobody), which no user's
	# containers may map. The range must fit below 2^32 - 1.
	for f in subuid subgid; do
		[ -f "$old/$f" ] && [ -f "$new/$f" ] || continue
		awk -F: -v u="$u" '$1 == u { n++; l = $0; ok = NF == 3 && $2 ~ /^[0-9]+$/ && $3 ~ /^[0-9]+$/ &&
			$2 >= 100000 && $3 >= 1 && $2 + $3 <= 4294967295 }
			END { if (n == 1 && ok) print l }' "$old/$f" >> "$new/$f" || true
	done
done
# The users' own groups (GID 1000-59999), then their membership in the image's groups.
for g in $(kept "$old/group" 4 | awk -F: '{ print $1 }'); do
	has "$new/group" "$g" && continue
	kept "$old/group" 4 "$g" >> "$new/group"
	gs="$(line "$old/gshadow" "$g")"
	echo "${gs:-$g:!::}" >> "$new/gshadow"
done
for f in group gshadow; do
	[ -f "$old/$f" ] || continue
	awk -F: -v OFS=: -v users=" $(echo $users) " -v dups="$dups" '
		NR == FNR { if (NF == 4 && !index(dups, " " $1 " ")) old[$1] = $4; next }
		NF == 4 && ($1 in old) {
			n = split(old[$1], m, ",")
			for (i = 1; i <= n; i++)
				if (index(users, " " m[i] " ") && index("," $4 ",", "," m[i] ",") == 0)
					$4 = ($4 == "" ? m[i] : $4 "," m[i])
		}
		{ print }' "$old/$f" "$new/$f" > "$new/$f.nyra-tmp"
	cat "$new/$f.nyra-tmp" > "$new/$f"
	rm "$new/$f.nyra-tmp"
done

sync
echo "reset-settings: switching to the new /etc"
# One step (renameat2 RENAME_EXCHANGE): afterwards etc.nyra-new holds the previous /etc.
mv -T --exchange "$new" "$old"
sync
echo "reset-settings: switched to the new /etc"
rm -f "$old/.nyra-reset-new"
rm -rf "$prev"
mv "$new" "$prev"
chmod 0700 "$prev"
sync
echo "System settings changed; the previous ones are in $prev. Restarting."
exec systemctl reboot
