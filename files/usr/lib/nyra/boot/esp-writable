#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# Nyra OS: esp-writable COMMAND [ARG...] runs COMMAND with the ESP writable at /boot, in a mount
# namespace of its own (docs/BOOT.md). Everywhere else the ESP is read-only at /boot, so nothing that
# walks the file system as root (rm -rf /, a stray script) can change the boot files.
# /boot, as boot.mount mounted it (read-only, after the ESP's file system check), is remounted
# read-write in this namespace only. That makes the file system writable, as bootc does for its own
# writes, while /boot stays read-only for every other process: read-only is also a flag of each
# mount, and theirs keep it.
# When /boot is not mounted (the ESP's file system check or boot.mount failed), nothing is written:
# the ESP is never mounted here without that check.
# Used by esp-sync and by the drop-ins of systemd-bless-boot and systemd-boot-random-seed.
set -eu

[ "$#" -gt 0 ] || { echo "usage: esp-writable COMMAND [ARG...]" >&2; exit 2; }
if ! findmnt -n -t vfat /boot > /dev/null; then
	# <3>: an error in the journal.
	echo "<3>esp-writable: the ESP is not mounted at /boot (its file system check or boot.mount failed, see journalctl -u boot.mount): nothing is written to it" >&2
	exit 1
fi
if [ "${NYRA_ESP_WRITABLE:-}" != 1 ]; then
	NYRA_ESP_WRITABLE=1 exec unshare --mount --propagation private -- "$0" "$@"
fi

# The classic mount(2) remount, with only these flags, as bootc does. Through the new mount API,
# mount(8) would pass the mount's options on to the superblock, and the kernel refuses dirsync there
# (EINVAL); dirsync stays as the first mount set it.
LIBMOUNT_FORCE_MOUNT2=always mount --options-source=disable -o remount,rw,nosuid,nodev,noexec,nosymfollow /boot

rc=0
"$@" || rc=$?
sync
exit "$rc"
