#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# Initrd only (nyra-root-wait.service): the root partition, plain or encrypted, must appear within
# 90 s, or the initrd goes to emergency mode (which reboots: rd.emergency=reboot), as it does without
# Nyra's change. The wait for the root device itself has no limit, because an encrypted root appears
# only once its passphrase is typed (docs/BOOT.md, "Disk encryption").
i=0
while [ "$i" -lt 90 ]; do
  if [ -e /dev/gpt-auto-root ] || [ -e /dev/gpt-auto-root-luks ]; then exit 0; fi
  sleep 1
  i=$((i + 1))
done
echo "nyra-root-wait: no root partition (/dev/gpt-auto-root) after 90 s; emergency mode" >&2
systemctl --no-block start emergency.target
