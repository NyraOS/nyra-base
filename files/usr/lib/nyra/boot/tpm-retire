#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# Once this version is confirmed good (nyra-tpm-retire.service, after boot-complete.target): remove the
# disk's TPM2 enrollments for policy keys that this version neither signed with nor carries as the
# next one (docs/BOOT.md, "Disk encryption"; docs/SIGNING.md, "The PCR policy key"). After a rotation
# that is the old key: versions signed only with it stop unlocking the disk by themselves, while a
# fallback to them before this confirmation still did. The keys to keep come from this boot's initrd
# (/run/nyra-tpm2-keep, nyra-tpm-enroll); the enrollments, by key slot number, from the disk's record.
# Removing a key slot needs no key and no TPM. Only when an enrollment for the key this version booted
# with is in the record, so that the disk always keeps one that works, and only the enrollments
# recorded before it: the record lists them in the order they were made, so a fallback to an older
# release that is confirmed good never removes the enrollment of a newer key (it still unlocks the
# newer release, which may be tried again).
set -eu

record=/var/lib/nyra/tpm2-slots
keep=/run/nyra-tpm2-keep
log() { echo "nyra-tpm-retire: $*"; }

[ -f "$record" ] && [ -f "$keep" ] || exit 0
current="$(sed -n 1p "$keep")"
grep -q "^[0-9][0-9]* $current\$" "$record" || exit 0
# The record's enrollments made before the current key's, for keys that are not kept.
old="$(sed -n "/^[0-9][0-9]* $current\$/q; /^[0-9][0-9]* /p" "$record" | grep -v -F -f "$keep" || true)"
[ -n "$old" ] || exit 0
dev="$(cryptsetup status root | sed -n 's/^ *device: *//p')"
[ -n "$dev" ] || { log "the encrypted root's device was not found"; exit 1; }
# Only the slots that are still there: a run cut off after removing them and before writing the record
# (a power cut) leaves a record that lists slots that are gone, and systemd-cryptenroll fails on those.
now="$(systemd-cryptenroll "$dev" | sed -n '2,$ s/^ *\([0-9][0-9]*\) .*/\1/p')"
wipe="$(echo "$old" | sed 's/ .*//' | grep -xF "${now:--}" | tr '\n' ',' | sed 's/,$//' || true)"
# The new record is written first: if it cannot be (a full /var), nothing is removed.
{
  grep -v -x -F "$old" "$record" || true
  echo "$old" | sed 's/^[0-9]* /retired /'
} > "$record.new"
[ -z "$wipe" ] || systemd-cryptenroll --wipe-slot="$wipe" "$dev"
mv "$record.new" "$record"
log "removed the enrollments of retired policy keys: $(echo "$old" | sed 's/ .*//' | tr '\n' ' ')"
