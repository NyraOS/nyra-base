# SPDX-License-Identifier: GPL-3.0-or-later
# Nyra: AppArmor profile of ntpd-rs's daemon (docs/DEFAULTS.md, "Time"), in enforce mode. The image
# build moves it to /etc/apparmor.d. ntpd-rs.service runs it with a dynamic user, so its state
# directory is /var/lib/private/ntpd-rs (/var/lib/ntpd-rs links there).

abi <abi/4.0>,

include <tunables/global>

profile ntp-daemon /usr/bin/ntp-daemon {
  include <abstractions/base>
  include <abstractions/nameservice>
  include <abstractions/ssl_certs>
  # The administrator's own CAs (update-ca-certificates): /usr/local is a link to /var/usrlocal on a
  # bootc system, and AppArmor checks the resolved path, which ssl_certs does not name.
  /var/usrlocal/share/ca-certificates/{,**} r,

  capability sys_time,

  network inet dgram,
  network inet6 dgram,
  network inet stream,
  network inet6 stream,
  # The machine's own addresses, and their changes (route netlink).
  network netlink raw,
  # The observation socket for ntp-ctl, systemd-resolved.
  unix,

  /usr/bin/ntp-daemon mr,
  /usr/lib/nyra/ntpd-rs/ntp.toml r,
  # A configuration of the administrator's (docs/DEFAULTS.md, "Time").
  /etc/ntpd-rs/ntp.toml r,
  /usr/lib/clock-epoch r,
  @{PROC}/sys/kernel/random/boot_id r,
  /var/lib/{,private/}ntpd-rs/ r,
  /var/lib/{,private/}ntpd-rs/last-clock-update rw,
  @{run}/ntpd-rs/observe rw,
  @{run}/systemd/resolve/io.systemd.Resolve rw,

  include if exists <local/usr.bin.ntp-daemon>
}
