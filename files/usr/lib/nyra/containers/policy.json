{
  "default": [{ "type": "insecureAcceptAnything" }],
  "transports": {
    "docker": {
      "updates.nyraos.com": [
        {
          "type": "sigstoreSigned",
          "fulcio": {
            "caPath": "/usr/lib/nyra/sigstore/fulcio-ca.pem",
            "oidcIssuer": "https://accounts.google.com",
            "subjectEmail": "nyra-image-signer@nyra-signing-3076.iam.gserviceaccount.com"
          },
          "rekorPublicKeyPath": "/usr/lib/nyra/sigstore/rekor.pub",
          "signedIdentity": { "type": "matchRepository" }
        }
      ]
    }
  }
}
