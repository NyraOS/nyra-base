# Nyra: wget's system settings (docs/DEFAULTS.md), linked from /etc/wgetrc, so they update
# with the image. wget reads this file first, then the user's ~/.wgetrc, then the command line, so
# `wget --htmlify` or a line in ~/.wgetrc still turns the HTML index back on.
# Debian's setting (the rest of its file is only comments):
passive_ftp = on
# `wget ftp://host/dir/` saves the server's own listing instead of building an HTML index from it.
htmlify = off
