# Before every update check (nyra-updated.service wants it and is ordered after it): waits, without
# a time limit, until systemd-networkd reports a link online. A check that comes due without a
# network runs as soon as one is back, not at the next timer run (docs/UPDATES.md, "Without a
# network"). Not network-online.target: once reached it stays active for the whole boot, and
# systemd-networkd-wait-online.service fails after 2 minutes without a network, which leaves the
# system degraded (docs/DEFAULTS.md, "Without a network").
[Unit]
Description=Nyra: wait for the network before an update check
Documentation=https://github.com/NyraOS/nyra-base/blob/main/docs/UPDATES.md
After=systemd-networkd.service

[Service]
Type=oneshot
# No RemainAfterExit: every check waits again. "-": if the wait itself fails, the check runs and
# reports what it finds; the system is never degraded by a wait for the network.
ExecStart=-/usr/lib/systemd/systemd-networkd-wait-online --any --timeout=0
TimeoutStartSec=infinity
# It only reads the link state (rtnetlink and /run/systemd/netif), as an unprivileged user.
DynamicUser=yes
CapabilityBoundingSet=
ProtectHome=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
RestrictAddressFamilies=AF_UNIX AF_NETLINK
