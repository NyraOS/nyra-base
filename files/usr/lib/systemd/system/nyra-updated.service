# Started by nyra-updated.timer: one update check (docs/UPDATES.md). It stages an update and never
# reboots; on a boot whose health checks did not pass (boot-complete.target) it does nothing.
[Unit]
Description=Nyra: check for a system update and prepare it
Documentation=https://github.com/NyraOS/nyra-base/blob/main/docs/UPDATES.md
# The check waits for the network, up to an hour (nyra-updated-wait-online.service), not for
# network-online.target, which nothing in the base pulls in (docs/DEFAULTS.md, "Without a network").
After=boot-complete.target nyra-updated-wait-online.service
Wants=nyra-updated-wait-online.service nyra-boot-repair.service
# Only with the ESP mounted at /boot, after its file system check: bootc writes there when it stages
# an update, and the boot counter at shutdown goes through esp-writable, which refuses without that
# mount (docs/BOOT.md, "Mounts from /etc/fstab"). Each start tries the check and the mount again.
# nyra-boot-repair is wanted too: when boot.mount failed at boot and only this start mounts the ESP,
# the repair (it removes a stale entries.staged) runs now, before bootc stages anything.
RequiresMountsFor=/boot

[Service]
Type=oneshot
# The links with a routable address on this healthy boot, for the network health check of the next
# version (/usr/lib/nyra/health/network); never fails the check.
ExecStartPre=-/usr/lib/nyra/health/network record
ExecStart=/usr/libexec/nyra-updated check
# nyra-updated stops a pull after 2 h itself (bootc and its helpers); this is only a backstop.
TimeoutStartSec=2h30min
StateDirectory=nyra-updated
StateDirectoryMode=0700
UMask=0077
# Sandboxing, as far as bootc allows: it runs as root in its own mount namespace (it remounts
# /sysroot and the read-only ESP read-write there, as esp-sync discard does through esp-writable),
# pulls over the network and writes /sysroot and /var.
# No RestrictSUIDSGID=: it makes openat2() fail with ENOSYS, and bootc has no fallback ("Opening
# runtime auth file: Function not implemented").
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=tmpfs
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
