[Unit]
Description=Nyra: boot loader settings on the ESP from /usr
Documentation=https://github.com/NyraOS/nyra-base/blob/main/docs/BOOT.md
RequiresMountsFor=/boot

[Service]
Type=oneshot
ExecStart=/usr/lib/nyra/boot/esp-sync loader-conf

[Install]
WantedBy=multi-user.target
