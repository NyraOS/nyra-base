# Health check (nyra-health-.service.d): the core services of the base are running, AppArmor's
# profiles loaded (/usr/lib/nyra/health/system has the list).
[Unit]
Description=Nyra health check: core services are running
Documentation=https://github.com/NyraOS/nyra-base/blob/main/docs/UPDATES.md
After=dbus.service systemd-journald.service systemd-logind.service systemd-udevd.service
After=systemd-networkd.service systemd-resolved.service apparmor.service

[Service]
Type=oneshot
CapabilityBoundingSet=
ExecStart=/usr/lib/nyra/health/system

[Install]
RequiredBy=boot-complete.target
