# Initrd only: the TPM2 enrollments of an encrypted root, at its first boot, after the TPM refused and
# after a policy key rotation (/usr/lib/nyra/boot/tpm-enroll). After the root disk is unlocked and bootc
# set the root up (the record of the enrollments is in its /var, the next policy key in its /usr), and
# done before the initrd ends: PCR 11 must still be at the signed enter-initrd value. A failure is
# logged and the boot goes on (the disk then asks for its recovery key).
[Unit]
Description=Nyra: enroll the root disk with the TPM
Documentation=https://github.com/NyraOS/nyra-base/blob/main/docs/BOOT.md
DefaultDependencies=no
ConditionPathExists=/etc/initrd-release
After=cryptsetup.target systemd-cryptsetup@root.service initrd-root-device.target sysroot.mount bootc-root-setup.service
Before=initrd.target initrd-switch-root.target

[Service]
Type=oneshot
ExecStart=/usr/lib/nyra/boot/tpm-enroll
# The key typed in this boot is in root's user keyring (systemd-cryptsetup put it there): link it
# into this unit's session keyring, so that the script can use it and then remove it.
KeyringMode=shared
