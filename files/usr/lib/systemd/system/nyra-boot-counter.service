# Active from boot, does its work when stopped at shutdown. Ordered after bootc-finalize-staged,
# so it stops first: the counter is in place before bootc swaps loader/entries.staged in. And after
# boot.mount, so /boot is still mounted then (without it, esp-writable writes nothing).
[Unit]
Description=Nyra: three boot tries for a newly staged system version
Documentation=https://github.com/NyraOS/nyra-base/blob/main/docs/BOOT.md
After=bootc-finalize-staged.service boot.mount

[Service]
Type=oneshot
RemainAfterExit=yes
# Without /boot mounted there is nothing to count, and esp-sync would log an error at every shutdown.
ExecStop=/bin/sh -c 'findmnt -n -t vfat /boot >/dev/null || exit 0; exec /usr/lib/nyra/boot/esp-sync boot-counter'

[Install]
WantedBy=multi-user.target
