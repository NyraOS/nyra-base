# Active from boot, does its work when stopped at shutdown. Ordered after bootc-finalize-staged,
# so it stops first: the counter is in place before bootc swaps loader/entries.staged in.
[Unit]
Description=Nyra: three boot tries for a newly staged system version
Documentation=https://github.com/WaggSoftware/nyra-base/blob/main/docs/BOOT.md
After=bootc-finalize-staged.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStop=/usr/lib/nyra/boot/esp-sync boot-counter

[Install]
WantedBy=multi-user.target
