# Started by nyra-etc-copy.timer: the daily copy of /etc for "Nyra OS Restore earlier settings"
# (docs/BOOT.md). nyra-updated makes one too, before it stages an update.
[Unit]
Description=Nyra: a copy of the system settings (/etc)
Documentation=https://github.com/NyraOS/nyra-base/blob/main/docs/BOOT.md

[Service]
Type=oneshot
ExecStart=/usr/lib/nyra/etc-copy daily
# It reads /etc and writes only its copies (/var/lib/nyra/etc-copies, 0700).
StateDirectory=nyra/etc-copies
StateDirectoryMode=0700
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
NoNewPrivileges=yes
# Root, but only what a copy with owners, modes and ACLs needs.
CapabilityBoundingSet=CAP_DAC_READ_SEARCH CAP_DAC_OVERRIDE CAP_CHOWN CAP_FOWNER CAP_FSETID
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX
Nice=19
IOSchedulingClass=idle
