#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# nyra update: tells an administrator which system version is available and installs it after a
# yes (docs/UPDATES.md, "Updating from a terminal as an administrator"). It needs no sudo and does no
# work as root itself: `nyra-updated available` (any user) finds the version, and `systemctl start`
# of nyra-updated-install@VERSION.service installs it, after polkit asks for the administrator's own
# password through systemctl's agent on this terminal. It never restarts the computer.
# An administrator can read neither the journal nor bootc's status, so the program leaves its result
# in a file everybody can read (RESULT), which this reads back.
# While the unit runs, the stage it writes (STAGE, fixed words) and the time are shown on one line.
# Everything that carries data is printed with printf '%s': dash's echo would act on a backslash in it.
# `nyra update --channel NAME` makes the computer follow another update channel (docs/UPDATES.md,
# "Channels"), the same way: systemctl start of nyra-updated-channel@NAME.service, with the
# administrator's own password; the next update check uses the new channel.
set -eu

PATH=/usr/bin:/bin
export PATH

RESULT=/run/nyra-updated-install.result
STAGE=/run/nyra-updated-install.stage

# What to do when the update is lost (the sentence is kept in one place).
AGAIN='Run `nyra update` again; the files already downloaded are reused.'

restart_note() { # the same two lines whenever a version waits for the restart
	printf 'Restart with `systemctl reboot` when you are ready to finish the update.\n'
	printf 'Do not force-reset the computer (for example with the Restart or Stop button of a virtual machine), or the update is lost. %s\n' "$AGAIN"
}

channel=
case "$#:${1:-}:${2:-}:${3:-}" in
1:update::) ;;
3:update:--channel:dev | 3:update:--channel:beta | 3:update:--channel:stable) channel="$3" ;;
*)
	echo "Usage: nyra update [--channel dev|beta|stable]" >&2
	exit 2
	;;
esac

if [ ! -t 0 ] || [ ! -t 1 ]; then
	echo "Run this in a terminal: it asks a question and a password." >&2
	exit 1
fi

case " $(id -nG) " in
*" sudo "*) ;;
*)
	echo "Only an administrator can update the system." >&2
	exit 1
	;;
esac

# The password is asked once, by systemctl's agent on this terminal (nyra-prompt-only shows only the
# prompt, as for an install below); the unit only writes the choice, so this waits for it.
if [ -n "$channel" ]; then
	errors="$(mktemp)"
	trap 'rm -f "$errors"' EXIT
	if /usr/libexec/nyra-prompt-only systemctl start "nyra-updated-channel@$channel.service" 2>"$errors"; then
		printf 'This computer now follows the %s channel. The next update check uses it.\n' "$channel"
		exit 0
	fi
	if grep -qiE 'access denied|authenticat|not authorized' "$errors"; then
		echo "The channel was not changed: the password was not accepted, the question was cancelled, or this is not a session at the computer itself." >&2
	else
		cat "$errors" >&2
		echo "The channel was not changed. If the system is checking for or installing an update, try again when it is done." >&2
	fi
	exit 1
fi

# The reason is printed by nyra-updated, in one line.
available="$(/usr/libexec/nyra-updated available)" || exit 1
# shellcheck source=/dev/null
installed="$(. /usr/lib/os-release && printf '%s' "$IMAGE_VERSION")"

if [ -z "$available" ]; then
	printf 'The system is up to date. Version %s is installed.\n' "$installed"
	exit 0
fi

# Prepared by an earlier run since the last restart, and still what the channel offers.
case "$(cat "$RESULT" 2>/dev/null)" in
"staged $available" | "staged $available already")
	printf 'Version %s is already prepared.\n' "$available"
	restart_note
	exit 0
	;;
esac

marker="$(mktemp)"
errors="$(mktemp)"
trap 'rm -f "$marker" "$errors"' EXIT
unit="nyra-updated-install@$available.service"

stop_waiting() {
	printf '\r\033[K'
	printf 'The update keeps preparing in the background; run `nyra update` again to see it.\n'
	exit 130
}

terminal_width() { # sets width: the columns of the terminal, 80 when they are not known
	width="$(stty size 2>/dev/null)"
	width="${width#* }"
	case "$width" in
	'' | *[!0-9]*) width=80 ;;
	esac
	[ "$width" -gt 0 ] || width=80
}

# Shows the stage and the time until the unit has neither a job nor a state that says it works, then
# the outcome. The outcome is only what the program wrote during this run (RESULT newer than the
# marker, for this version): the state of the unit cannot say it, since a unit that was never run
# (a mount it needs failed, root stopped it) is inactive too. An answer of systemctl that is empty
# is not known, which is not finished: it is waited for, for 30 seconds at most.
wait_for_unit() { # wait_for_unit STAGE: STAGE is shown until the program writes one
	started="$(date +%s)"
	# Ctrl+C stops the waiting only: systemd keeps the job.
	trap stop_waiting INT
	stage="$1"
	unknown=0
	while [ "$unknown" -lt 30 ]; do
		info="$(systemctl show -p Job -p ActiveState "$unit" 2>/dev/null)" || info=
		case "$info" in
		*ActiveState=*) unknown=0 ;;
		*)
			unknown=$((unknown + 1))
			sleep 1
			continue
			;;
		esac
		# A job, or the unit still working: it goes on.
		case "$info" in
		*Job=[0-9]* | *ActiveState=activating*) ;;
		*) break ;;
		esac
		# Only a stage written during this run: an older line belongs to another one.
		if [ -n "$(find "$STAGE" -newer "$marker" 2>/dev/null)" ]; then
			stage="$(cat "$STAGE")"
		fi
		elapsed=$(($(date +%s) - started))
		time="$(printf '%d:%02d' $((elapsed / 60)) $((elapsed % 60)))"
		line="$stage... $time"
		terminal_width
		# A line as wide as the terminal would wrap, and the next \r would only reach its last row.
		if [ "${#line}" -ge "$width" ]; then
			line="$time"
		fi
		printf '\r\033[K%s' "$line"
		sleep 1
	done
	trap - INT
	printf '\r\033[K'
	if [ "$unknown" -ge 30 ]; then
		echo "The update could not be followed. Run \`nyra update\` again to see how it went." >&2
		exit 1
	fi
	# The program writes its result before the unit ends; a few seconds of grace cover the rest.
	for _ in 1 2 3 4 5; do
		[ -z "$(find "$RESULT" -newer "$marker" 2>/dev/null)" ] || break
		sleep 1
	done
}

finish() { # the outcome of this run, after wait_for_unit
	result=
	if [ -n "$(find "$RESULT" -newer "$marker" 2>/dev/null)" ]; then
		result="$(cat "$RESULT" 2>/dev/null)" || result=
	fi
	case "$result" in
	"staged $available")
		printf 'Installed version %s.\n' "$available"
		restart_note
		;;
	"staged $available already")
		printf 'Version %s was already prepared.\n' "$available"
		restart_note
		;;
	"failed $available "*)
		reason="${result#"failed $available "}"
		printf 'The update was not installed: %s.\n' "${reason%.}" >&2
		exit 1
		;;
	*)
		echo "The update was not installed." >&2
		exit 1
		;;
	esac
}

# A run that was started before, and left with Ctrl+C, is still going: show it instead of asking.
if [ "$(systemctl show -p ActiveState --value "$unit" 2>/dev/null)" = activating ]; then
	printf 'Version %s is being prepared.\n' "$available"
	wait_for_unit Preparing
	finish
	exit 0
fi

printf 'Version %s is installed. %s is available. Install it? [y/N] ' "$installed" "$available"
answer=n
read -r answer || true
case "$answer" in
y | Y | yes | YES | Yes) ;;
*)
	echo "Nothing was installed."
	exit 0
	;;
esac

# systemctl's own messages go to a file: its password prompt is on the terminal, not on stderr. The
# password is asked here, once; the job then runs on without this command. The banner polkit's agent
# prints around the prompt (the action, its message) is on the terminal too, so nyra-prompt-only
# shows only the prompt. A failure shows through stderr and the exit status, which it passes on.
if ! /usr/libexec/nyra-prompt-only systemctl start --no-block "$unit" 2>"$errors"; then
	if grep -qiE 'access denied|authenticat|not authorized' "$errors"; then
		echo "Nothing was installed: the password was not accepted, the question was cancelled, or this is not a session at the computer itself." >&2
	else
		cat "$errors" >&2
		echo "The update was not installed." >&2
	fi
	exit 1
fi
printf 'Preparing version %s. This can take a few minutes; Ctrl+C stops only the waiting.\n' "$available"
wait_for_unit Starting
finish
