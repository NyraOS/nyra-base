// SPDX-License-Identifier: GPL-3.0-or-later
// Nyra's polkit rules (docs/DEFAULTS.md, "Removable media"). polkit reads the rule files of
// /etc/polkit-1/rules.d and /usr/share/polkit-1/rules.d in the order of their names, and the first
// rule that answers wins: this file comes before Debian's 50-default.rules, and an administrator's
// file with a lower number in /etc comes before it.

// The administrators whose password an "admin" prompt asks for: the group sudo, as Debian's
// 50-default.rules says, named here so that Nyra decides it.
polkit.addAdminRule(function(action, subject) {
    return ["unix-group:sudo"];
});

// Only with an administrator's password, although udisks2 allows them to any active local session:
// - loop-setup: attaching a file as a loop device makes the kernel read a file system that the
//   user built;
// - modify-device: changing a removable disk (its label, formatting, partitions). libblockdev passes
//   a new label to fatlabel unchecked, so a label starting with "-" becomes an option of fatlabel
//   (CVE-2026-111581, low, not fixed in Debian yet). Nothing in the base needs it yet.
polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.udisks2.loop-setup" ||
        action.id == "org.freedesktop.udisks2.modify-device") {
        return polkit.Result.AUTH_ADMIN;
    }
});

// Updating from a terminal (docs/UPDATES.md): a member of sudo, in a local and active session (not over
// SSH), starts nyra-updated-install@VERSION.service with `systemctl start`, and polkit asks for their
// OWN password (AUTH_SELF: it does not depend on who the polkit administrators are). Nothing else of
// systemd's manager is open to a user: with an administrator's password systemd's own policy lets
// them run any command as root (`systemd-run`, `run0`), start or stop any unit, link unit files and
// set the manager's environment, which would be the root shell the base does not have. root is not
// asked (polkit allows root everything). The unit name has the shape the program accepts
// (nyra-updated, install.rs), which it checks again.
var nyraInstallUnit = /^nyra-updated-install@[0-9]{4}\.[0-9]{1,2}\.[0-9]{1,6}\.service$/;
var nyraManagerActions = [
    "org.freedesktop.systemd1.manage-units",
    "org.freedesktop.systemd1.manage-unit-files",
    "org.freedesktop.systemd1.reload-daemon",
    "org.freedesktop.systemd1.set-environment"
];
polkit.addRule(function(action, subject) {
    if (nyraManagerActions.indexOf(action.id) < 0) {
        return;
    }
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        action.lookup("verb") == "start" &&
        nyraInstallUnit.test(action.lookup("unit")) &&
        subject.isInGroup("sudo") &&
        subject.local && subject.active) {
        return polkit.Result.AUTH_SELF;
    }
    return polkit.Result.NO;
});
