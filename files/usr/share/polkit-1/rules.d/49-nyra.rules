// Nyra's polkit rules (docs/DEFAULTS.md, "Removable media"). polkit reads the rule files of
// /etc/polkit-1/rules.d and /usr/share/polkit-1/rules.d in the order of their names, and the first
// rule that answers wins: this file comes before Debian's 50-default.rules, and an administrator's
// file with a lower number in /etc comes before it.

// The administrators whose password an "admin" prompt asks for: the group sudo, as Debian's
// 50-default.rules says, named here so that Nyra decides it.
polkit.addAdminRule(function(action, subject) {
    return ["unix-group:sudo"];
});

// Only with an administrator's password, although udisks2 allows them to any active local session:
// - loop-setup: attaching a file as a loop device makes the kernel read a file system that the
//   user built;
// - modify-device: changing a removable disk (its label, formatting, partitions). libblockdev passes
//   a new label to fatlabel unchecked, so a label starting with "-" becomes an option of fatlabel
//   (CVE-2026-111581, low, not fixed in Debian yet). Nothing in the base needs it yet.
polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.udisks2.loop-setup" ||
        action.id == "org.freedesktop.udisks2.modify-device") {
        return polkit.Result.AUTH_ADMIN;
    }
});
