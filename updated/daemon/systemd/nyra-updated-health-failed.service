# Not in the image yet (NyraOS#66). Started by any failed nyra-health-*.service: a full
# reboot while the version is on trial (or after a soft reboot), so boot counting falls back.
[Unit]
Description=Nyra: a health check failed, reboot so boot counting can fall back
DefaultDependencies=no

[Service]
Type=oneshot
ExecStart=/usr/libexec/nyra-updated health-failed
