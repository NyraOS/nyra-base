# SPDX-License-Identifier: GPL-3.0-or-later
# The release tree (the files of one release, with a file RELEASE: tools/install/release-tree.sh), read
# from the ISO, read-only, where the installer looks for its script. Nothing else is read from anywhere.
[Unit]
Description=The release tree on the installer medium
Requires=run-iso.mount
After=run-iso.mount

[Mount]
What=/run/iso/release
Where=/usr/lib/nyra/release
Type=none
Options=bind,ro,nosuid,nodev
