#!/usr/bin/env bash
# Nyra OS: refuse direct pushes to main (docs/AGENTI.md). Work goes through a branch and a pull request.
# An accident guard, not a security boundary: the free GitHub plan has no branch protection on private repos.
# The owner can push to main on purpose with NYRA_ALLOW_MAIN=1.
while read -r _ _ remote_ref _; do
  if [ "$remote_ref" = "refs/heads/main" ] && [ "${NYRA_ALLOW_MAIN:-0}" != "1" ]; then
    echo "pre-push: direct push to main refused. Push a branch and open a pull request (docs/AGENTI.md)." >&2
    exit 1
  fi
done
exit 0
